WILLIE_API_TOKEN=replace_with_real_token
ORANGE_LIVE_OBJECTS_API_KEY=replace_with_real_api_key

# Server
PORT=4000

# Client id & secret Partageons l'Eau
PLE_BASE_URL=http://localhost:5000
PLE_WEBHOOK_SECRET=replace_with_real_secret
CLIENT_ID=
CLIENT_SECRET=

# Sentry config
SENTRY_DSN=
SENTRY_ENV=

# Redis config (required for BullMQ workers - background job processing)
REDIS_URL=redis://localhost:6380
REDIS_TLS_CA_FILE_PATH=

# BullBoard - Dashboard de monitoring des queues (optionnel)
# Accessible sur /admin/queues avec authentification Basic
# Si non défini, BullBoard est désactivé
BULLBOARD_PASSWORD=
